# Server
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxxx.mongodb.net/expense-tracker

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Comma-separated list of allowed frontend origins
# Production Vercel URL: https://expense-tracker-frontend-deploy.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://expense-tracker-frontend-deploy.vercel.app
